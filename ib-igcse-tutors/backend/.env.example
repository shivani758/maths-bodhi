NODE_ENV=development
HOST=localhost
PORT=4000

# PostgreSQL. DATABASE_URL is preferred; split variables are the fallback.
# If both are set, the password in DATABASE_URL and DB_PASSWORD must match.
DB_PROVIDER=postgres
DATABASE_URL=postgresql://mathsbodhi_user:replace-with-a-database-password@127.0.0.1:5432/mathsbodhi
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mathsbodhi
DB_USER=mathsbodhi_user
DB_PASSWORD=replace-with-a-database-password

# Do not reuse the PostgreSQL password as SESSION_SECRET.
SESSION_SECRET=replace-with-a-long-random-session-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret

SESSION_COOKIE_NAME=maths_bodhi_admin_sid
# Use "none" for split-domain staging/production frontends such as Vercel -> Render.
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
FRONTEND_ORIGIN=http://localhost:5173

ADMIN_SEED_NAME=Maths Bodhi Super Admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-admin-seed-password
